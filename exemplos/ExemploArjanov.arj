func soma(int a, int b): int {
    return a + b;
}

func media(int a, float b): float {
    return (a + b) / 2;
}

func vazia() {
    return;
}

func mostra(str msg) {
    puts(msg);
}

func dobro(int n): float {
    return n * 2;
}

func sinal(int n): int {
    if (n < 0) {
        return -1;
    } else {
        return 1;
    }
}

func avalia(str nota) {
    switch (nota) {
        case 'A':
            puts('excelente');
        case 'B':
            puts('aprovado');
            break;
        default:
            puts('reprovado');
    }
}

func classifica(int n): int {
    if (n > 0) {
        mostra('positivo');
    } else {
        if (n < 0) {
            mostra('negativo');
        }
    }
    return n;
}

func fat(int n): int {
    if (n <= 1) {
        return 1;
    }
    return n * fat(n - 1);
}

