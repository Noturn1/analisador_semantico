func soma(int a, int b): int {
    return a + b;
}

func media(int a, float b): float {
    return (a + b) / 2;
}

func vazia() {
    return;
}

func mostra(str msg) {
    puts(msg);
}

func classifica(int n): int {
    if (n > 0) {
        mostra('positivo');
    } else {
        if (n < 0) {
            mostra('negativo');
        }
    }
    return n;
}

func fat(int n): int {
    if (n <= 1) {
        return 1;
    }
    return n * fat(n - 1);
}

